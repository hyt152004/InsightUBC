n is in IInsightFacade\n *\n */\nexport default class InsightFacade implements IInsightFacade {\n\tpublic datasetMap: Map<string, InsightDataset> = new Map<string, InsightDataset>();\n\n\tpublic async addDataset(id: string, content: string, kind: InsightDatasetKind): Promise<string[]> {\n\t\treturn new Promise<string[]>((resolve, reject) => {\n\t\t\tconst dsProcessor = new DatasetProcessor();\n\t\t\t// Check if dataset with same id already exist\n\t\t\tif (this.datasetMap.has(id)) {\n\t\t\t\treturn reject(new InsightError(\"Duplicated Id\"));\n\t\t\t}\n\t\t\tif (this.invalidId(id)) {\n\t\t\t\treject(new InsightError(\"Invalid ID\"));\n\t\t\t}\n\t\t\tdsProcessor\n\t\t\t\t.addSectionsDataset(id, content, kind)\n\t\t\t\t.then((ds) => {\n\t\t\t\t\tthis.datasetMap.set(ds.id, ds);\n\t\t\t\t\tconst keys = Array.from(this.datasetMap.keys());\n\t\t\t\t\treturn resolve(keys);\n\t\t\t\t})\n\t\t\t\t.catch((err) => {\n\t\t\t\t\treturn reject(err);\n\t\t\t\t});\n\t\t});\n\t}\n\n\tpublic async removeDataset(id: string): Promise<string> {\n\t\treturn new Promise<string>((resolve, reject) => {\n\t\t\tif (this.invalidId(id)) {\n\t\t\t\treject(new InsightError(\"Ivalid ID\"));\n\t\t\t}\n\t\t\t// Check if dataset with id doesn't exist\n\t\t\tif (!this.datasetMap.has(id)) {\n\t\t\t\treturn reject(new NotFoundError(\"id not found\"));\n\t\t\t}\n\t\t\tthis.datasetMap.delete(id);\n\t\t\tresolve(id);\n\t\t});\n\t}\n\n\tpublic async performQuery(query: unknown): Promise<InsightResult[]> {\n\t\t// TODO: Remove this once you implement the methods!\n\n\t\tthrow new Error(`InsightFacadeImpl::performQuery() is unimplemented! - query=${query};`);\n\t}\n\n\tpublic async listDatasets(): Promise<InsightDataset[]> {\n\t\treturn new Promise<InsightDataset[]>((resolve, reject) => {\n\t\t\ttry {\n\t\t\t\tconst result: InsightDataset[] = [];\n\t\t\t\tfor (const ds of this.datasetMap.values()) {\n\t\t\t\t\tconst dataset: InsightDataset = {\n\t\t\t\t\t\tid: ds.id,\n\t\t\t\t\t\tkind: ds.kind,\n\t\t\t\t\t\tnumRows: ds.numRows,\n\t\t\t\t\t};\n\t\t\t\t\tresult.push(dataset);\n\t\t\t\t}\n\t\t\t\tresolve(result);\n\t\t\t} catch (err) {\n\t\t\t\treturn reject(err);\n\t\t\t}\n\t\t});\n\t}\n\n\tprivate invalidId(id: string): boolean {\n\t\tif (id === null) {\n\t\t\treturn true;\n\t\t}\n\t\tif (id.trim() === \"\") {\n\t\t\treturn true;\n\t\t}\n\t\tif (id.includes(\"_\")) {\n\t\t\treturn true;\n\t\t}\n\n\t\treturn false;\n\t}\n}\n"]},"_coverageSchema":"1a1c01bbd47fc00a2c39e90264f33305004495a9","hash":"31447051a332def4a0bf7b2a341a9f53ea4f3650","contentHash":"e1e4169037b183281ac6779d050faf2267fe2a999fd6568bb0464dae3bdc85a2"},"/home/j/jshum01/project_team159/src/controller/DatasetProcessor.ts":{"path":"/home/j/jshum01/project_team159/src/controller/DatasetProcessor.ts","statementMap":{"0":{"start":{"line":2,"column":22},"end":{"line":4,"column":1}},"1":{"start":{"line":3,"column":4},"end":{"line":3,"column":62}},"2":{"start":{"line":5,"column":0},"end":{"line":5,"column":62}},"3":{"start":{"line":6,"column":16},"end":{"line":6,"column":49}},"4":{"start":{"line":7,"column":25},"end":{"line":7,"column":52}},"5":{"start":{"line":8,"column":18},"end":{"line":8,"column":62}},"6":{"start":{"line":9,"column":26},"end":{"line":9,"column":78}},"7":{"start":{"line":12,"column":22},"end":{"line":12,"column":43}},"8":{"start":{"line":13,"column":8},"end":{"line":34,"column":11}},"9":{"start":{"line":14,"column":12},"end":{"line":33,"column":15}},"10":{"start":{"line":16,"column":37},"end":{"line":16,"column":69}},"11":{"start":{"line":18,"column":16},"end":{"line":29,"column":19}},"12":{"start":{"line":19,"column":45},"end":{"line":19,"column":81}},"13":{"start":{"line":21,"column":20},"end":{"line":23,"column":21}},"14":{"start":{"line":22,"column":24},"end":{"line":22,"column":109}},"15":{"start":{"line":24,"column":31},"end":{"line":24,"column":113}},"16":{"start":{"line":25,"column":20},"end":{"line":25,"column":39}},"17":{"start":{"line":28,"column":20},"end":{"line":28,"column":39}},"18"