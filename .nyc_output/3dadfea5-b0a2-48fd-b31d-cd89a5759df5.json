ion from \"../model/Section\";\nimport SectionsDataset from \"../model/SectionsDataset\";\n// import Log from \"../../util/Log\";\n\nexport default class DatasetProcessor {\n\tpublic async addSectionsDataset(id: string, content: string, kind: InsightDatasetKind): Promise<InsightDataset> {\n\t\tconst jszip = new JSZip();\n\t\t// let fs = require(\"fs-extra\");\n\n\t\treturn new Promise<InsightDataset>((resolve, reject) => {\n\t\t\t//TODO: Split codes into helper functions (function cannot exceed 35 lines)\n\n\t\t\t// Load zip content\n\t\t\tjszip\n\t\t\t\t.loadAsync(content, { base64: true })\n\t\t\t\t.then(async (zip) => this.pushAllSection(zip, reject))\n\t\t\t\t.then((allSections) => {\n\t\t\t\t\t// Wait until all courses are processed\n\t\t\t\t\tPromise.all(allSections)\n\t\t\t\t\t\t.then((coursesResult) => this.pushValidSection(coursesResult))\n\t\t\t\t\t\t.then((allValidSections) => {\n\t\t\t\t\t\t\t// check if the valid sections are empty AFTER all courses have been processed\n\t\t\t\t\t\t\tif (allValidSections.length === 0) {\n\t\t\t\t\t\t\t\treturn reject(new InsightError(\"Not a single valid section found\"));\n\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\t// Return an InsightDataset with all the valid sections added AFTER all courses have been processed\n\t\t\t\t\t\t\tconst ds = new SectionsDataset(id, kind, allValidSections.length, allValidSections);\n\t\t\t\t\t\t\treturn resolve(ds);\n\t\t\t\t\t\t})\n\t\t\t\t\t\t.catch((err) => {\n\t\t\t\t\t\t\treturn reject(err);\n\t\t\t\t\t\t});\n\t\t\t\t})\n\t\t\t\t.catch((err) => {\n\t\t\t\t\treturn reject(err);\n\t\t\t\t});\n\t\t});\n\t}\n\n\tprivate async pushAllSection(zip: JSZip, reject: (error: InsightError) => void): Promise<Promise<string>[]> {\n\t\tconst allSections: Promise<string>[] = [];\n\t\tconst coursesFolder = zip.folder(/^courses\\/$/);\n\n\t\t// Check if courses folder exists and is at root level\n\t\tif (coursesFolder !== null) {\n\t\t\tlet numberOfFiles = 0;\n\t\t\tzip.folder(\"courses\")?.forEach(function (_relativePath: string, file: any) {\n\t\t\t\tnumberOfFiles++;\n\t\t\t\tallSections.push(file.async(\"string\"));\n\t\t\t});\n\n\t\t\tif (numberOfFiles === 0) {\n\t\t\t\treject(new InsightError(\"courses folder is empty\"));\n\t\t\t\treturn Promise.reject();\n\t\t\t}\n\t\t} else {\n\t\t\treject(new InsightError(\"courses folder not found\"));\n\t\t\treturn Promise.reject();\n\t\t}\n\n\t\treturn allSections;\n\t}\n\n\tprivate pushValidSection(listOfResult: string[]): Section[] {\n\t\tconst allValidSections: Section[] = [];\n\n\t\tfor (const JSONfile of listOfResult) {\n\t\t\tconst course = JSON.parse(JSONfile);\n\t\t\t// make sure each result key exists\n\t\t\tif (!Object.prototype.hasOwnProperty.call(course, \"result\")) {\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tfor (const section of course.result) {\n\t\t\t\t// If a section has missing field, it is invalid (skip it)\n\t\t\t\tif (this.missingQueryKey(section)) {\n\t\t\t\t\tcontinue;\n\t\t\t\t}\n\t\t\t\tconst validSection = new Section(section);\n\t\t\t\tallValidSections.push(validSection);\n\t\t\t}\n\t\t}\n\n\t\treturn allValidSections;\n\t}\n\n\tprivate missingQueryKey(section: any): boolean {\n\t\tif (!Object.prototype.hasOwnProperty.call(section, \"Course\")) {\n\t\t\treturn true;\n\t\t}\n\t\tif (!Object.prototype.hasOwnProperty.call(section, \"Title\")) {\n\t\t\treturn true;\n\t\t}\n\t\tif (!Object.prototype.hasOwnProperty.call(section, \"Professor\")) {\n\t\t\treturn true;\n\t\t}\n\t\tif (!Object.prototype.hasOwnProperty.call(section, \"Subject\")) {\n\t\t\treturn true;\n\t\t}\n\t\tif (!Object.prototype.hasOwnProperty.call(section, \"Year\")) {\n\t\t\treturn true;\n\t\t}\n\t\tif (!Object.prototype.hasOwnProperty.call(section, \"Avg\")) {\n\t\t\treturn true;\n\t\t}\n\t\tif (!Object.prototype.hasOwnProperty.call(section, \"Pass\")) {\n\t\t\treturn true;\n\t\t}\n\t\tif (!Object.prototype.hasOwnProperty.call(section, \"Fail\")) {\n\t\t\treturn true;\n\t\t}\n\t\tif (!Object.prototype.hasOwnProperty.call(section, \"Audit\")) {\n\t\t\treturn true;\n\t\t}\n\t\treturn false;\n\t}\n}\n"]},"_coverageSchema":"1a1c01bbd47fc00a2c39e90264f33305004495a9","hash":"b40ee09ecf546ab5c87e69db86aa9cdd2ae66765","contentHash":"96fb18f38a211aeca5796e8ade9d1a7b1273df8a4c1f5c705bea41a0f275c5d9"},"/home/j/jshum01/project_team159/src/model/Section.ts":{"path":"/home/j/jshum01/project_team159/src/model/Section.ts","statementMap":{"0":{"start":{"line":2,"column":0},"end":{"line":2,"column":62}},"1":{"start":{"line":15,"column":8},"end":{"line":15,"column":28}},"2":{"start":{"line":16,"column":8},"end":{"line":16,"column":30}},"3":{"start":{"line":17,"column":8},"end":{"line":17,"column":32}},"4":{"start":{"line":18,"column":8},"end":{"line":18,"column":41}},"5":{"start":{"line":19,"column":8},"end":{"line":19,"column":33}},"6":{"start":{"line":20,"column":8},"end":{"line":20,"column":30}},"7":{"start":{"line":21,"column":8},"end":{"line":21,"column":28}},"8":{"start":{"line":22,"column":8},"end":{"line":22,"column":30}},"9":{"start":{"line":23,"column":8},"end":{"line":23,"column":30}},"10":{"start":{"line":24,"column":8},"end":{"line":24,"column":32}},"11":{"start":{"line":27,"column":0},"end":{"line":27,"column":26}}},"fnMap":{"0":{"name":"(anonymous_0)","decl":{"start":{"line":14,"column":4},"end":{"line":14,"column":5}},"loc":{"start":{"line":14,"column":22},"end":{"line":25,"column":5}},"line":14}},"branchMap":{},"s":{"0":1,"1":193865,"2":193865,"3":193865,"4":193865,"5":193865,"6":193865,"7":193865,"8":193865,"9":193865,"10":193865,"11":1},"f":{"0":193865},"b":{},"inputSourceMap":{"version":3,"file":"/home/j/jshum01/project_team159/src/model/Section.ts","sources":["/home/j/jshum01/project_team159/src/model/Section.ts"],"names":[],"mappings":";;AAAA,MAAqB,OAAO;IACnB,IAAI,CAAS;IACb,EAAE,CAAS;IACX,KAAK,CAAS;IACd,UAAU,CAAS;IACnB,IAAI,CAAS;IACb,IAAI,CAAS;IACb,GAAG,CAAS;IACZ,IAAI,CAAS;IACb,IAAI,CAAS;IACb,KAAK,CAAS;IAEtB,YAAY,IAAS;QACpB,IAAI,CAAC,IAAI,GAAG,IAAI,CAAC,EAAE,CAAC;QACpB,IAAI,CAAC,EAAE,GAAG,IAAI,CAAC,M