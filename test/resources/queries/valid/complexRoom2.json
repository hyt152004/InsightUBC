{
	"title": "Group and two apply on Room dataset",
	"input": {
		"WHERE": {
			"AND": [
				{
					"IS": {
						"rooms_furniture": "*Tables*"
					}
				},
				{
					"GT": {
						"rooms_seats": 300
					}
				}
			]
		},
		"OPTIONS": {
			"COLUMNS": [
				"rooms_shortname",
				"maxSeats",
				"minLatitude"
			],
			"ORDER": {
				"dir": "DOWN",
				"keys": [
					"maxSeats"
				]
			}
		},
		"TRANSFORMATIONS": {
			"GROUP": [
				"rooms_shortname"
			],
			"APPLY": [
