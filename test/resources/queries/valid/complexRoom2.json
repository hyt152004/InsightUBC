					}
				},
				{
					"minLatitude": {
						"MIN": "rooms_lat"
					}
				}
			]
		}
	},
	"errorExpected": false,
	"expected": [
		{
			"rooms_shortname": "OSBO",
			"maxSeats": 442,
			"minLatitude": 49.26047
		},
		{
			"rooms_shortname": "HEBB",
