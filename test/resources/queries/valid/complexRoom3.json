{
	"title": "Group and apply on Room dataset and order by two keys",
	"input": {
		"WHERE": {
			"AND": [
				{
					"IS": {
						"rooms_furniture": "*Tables*"
					}
				},
				{
					"GT": {
						"rooms_seats": 300
					}
				}
			]
		},
		"OPTIONS": {
			"COLUMNS": [
				"rooms_href",
				"countOfShortName",
				"sumLon"
			],
			"ORDER": {
				"dir": "DOWN",
				"keys": [
					"sumLon",
					"rooms_href"
				]
			}
		},
		"TRANSFORMATIONS": {
			"GROUP": [
				"rooms_href"
			],
			"APPLY": [
				{
					"sumLon": {
						"SUM": "rooms_lon"
					}
				},
				{
					"countOfShortName": {
						"COUNT": "rooms_shortname"
					}
				}
			]
		}
	},
	"errorExpected": false,
